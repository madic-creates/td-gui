{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  onboarding: false,
  requireConfig: 'ignored',
  extends: [
    'config:recommended',
  ],
  'pre-commit': {
    enabled: true,
  },
  assignees: [
    'madic-creates',
  ],
  repositories: [
    'madic-creates/td-gui',
  ],
  gitAuthor: 'Renovate Bot <bot@renovateapp.com>',
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  // Run `go mod tidy` as part of each Go update branch so the pushed go.sum is
  // already canonical. Without this, Renovate only touches the bumped module's
  // hashes and leaves stale entries behind — which the CI `tidy` job would then
  // reject. Opt-in because tidy can touch lines unrelated to the bump; here
  // that trade-off is exactly what we want.
  postUpdateOptions: [
    'gomodTidy',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  platform: 'github',
  automerge: true,
  // PR, not branch: .github/workflows/ci.yaml only triggers on `pull_request`
  // and on pushes to main. A branch-automerge push would run no checks at all,
  // so the automerge would either stall forever or land untested code. With a
  // PR, the full suite runs and Renovate merges once it is green.
  automergeType: 'pr',
  major: {
    automerge: false,
  },
  minor: {
    automerge: true,
  },
  patch: {
    automerge: true,
  },
  packageRules: [
    {
      // web/ is a single frontend bundle: React, Vite, Vitest and their types
      // move together and are all covered by the same CI job. One grouped PR
      // per update round beats a dozen individual ones.
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'web dependencies',
    },
    {
      // These two files sit outside ci.yaml's `paths` allowlist, so a PR that
      // touches only them starts no CI run and carries no status checks at
      // all. Renovate's default is to wait for a *passing* check before it
      // automerges, so without this the PR would sit open forever — the exact
      // stall `automergeType: 'pr'` above was chosen to avoid, re-entering
      // through the path filter instead.
      //
      // Opting them out of the gate is the right half of the trade, not
      // widening the allowlist: ci.yaml deliberately lists only files that can
      // affect a build, a test or a release artifact, and neither of these
      // can. Adding them would spend the full suite on a hook bump and, worse,
      // cut a patch release for it — `chore(deps)` is a patch rule in
      // .semrelrc — shipping a binary that is behaviourally identical.
      //
      // What still guards these: majors stay manual (`major.automerge` is
      // false), so only minor/patch land unattended, and `minimumReleaseAge`
      // gives every one of them a 5-day soak first. Blast radius is small in
      // both directions — a bad hook rev breaks local `pre-commit run` (no CI
      // job runs it), and a bad action bump breaks this workflow, which is
      // self-announcing.
      matchFileNames: [
        '.pre-commit-config.yaml',
        '.github/workflows/renovate.yaml',
      ],
      ignoreTests: true,
    },
    {
      // The one dep whose bump Renovate cannot land unattended. ci.yaml pins
      // the semantic-release binary by version *and* by sha256, and Renovate
      // can only move the first: a github-releases "digest" is the release's
      // commit SHA, not the checksum of an asset, so there is no template that
      // rewrites SEMREL_SHA256 alongside SEMREL_VERSION.
      //
      // Left on automerge that is a trap rather than a breakage. The release
      // job runs on pushes to main only, so the bump PR never executes the
      // step it just edited, goes green on the other jobs and merges — and the
      // mismatch surfaces on main. Nothing corrupts (the digest is checked
      // before the tag is published, so a failure costs a release, never a
      // dangling tag), but it strands releases until a human intervenes.
      //
      // So make the human the one who merges it. Whoever takes the PR updates
      // both lines together, from the checksums.txt asset of the same release.
      matchDepNames: [
        'go-semantic-release/semantic-release',
      ],
      automerge: false,
    },
  ],
  // ci.yaml installs a pinned upstream binary by URL — no manager sees that,
  // so the version would silently rot without this. Keyed on an explicit
  // `# renovate:` comment rather than on the variable name alone: TD_VERSION
  // sits in the same file and is deliberately the *oldest* td we support, so
  // it must never be bumped automatically. Opting in by comment is what keeps
  // these two apart.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '.github/workflows/*.yaml',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)\\s+[A-Z0-9_]+_VERSION: (?<currentValue>\\S+)',
      ],
    },
  ],
  minimumReleaseAge: '5 days',
  // Apply the age check only when the datasource provides a release timestamp.
  // Without this, sources that don't expose per-version timestamps get stuck
  // with pendingChecks=true and are filtered out by internalChecksFilter:
  // 'strict', so no update PR is ever opened.
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  internalChecksFilter: 'strict',
}
